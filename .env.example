APP_ENV=development
DATABASE_URL=sqlite:///./voicebot_demo.db
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
VOICE_RATE_LIMIT_REQUESTS=30
CLINIC_UTC_OFFSET_MINUTES=330

# Optional: enables ten-language detection and cloud playback for seven languages.
# Sinhala, Tamil and Arabic playback stays local. Never put a key in app/static/.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=coral
OPENAI_TIMEOUT_SECONDS=45
